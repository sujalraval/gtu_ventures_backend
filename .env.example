# Auth Configuration
JWT_SECRET="generate-a-long-random-string-here"
JWT_EXPIRES_IN=7d

# CORS Configuration (Comma separated origins)
ALLOWED_ORIGINS="https://apply.datarsoft.tech,http://localhost:5173"
