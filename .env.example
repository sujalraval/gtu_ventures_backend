PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public
NODE_ENV=production

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-app-password"
