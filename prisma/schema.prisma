generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminProfile {
  id         String  @id @default(uuid())
  employeeId String? @unique
  department String?
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgreementClause {
  id         String           @id @default(uuid())
  sectionId  String
  title      String
  content    String
  order      Int
  isOptional Boolean          @default(false)
  version    Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  section    AgreementSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model AgreementPart {
  id         String             @id @default(uuid())
  templateId String
  code       String
  title      String
  order      Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  template   AgreementTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sections   AgreementSection[]
}

model AgreementSection {
  id              String            @id @default(uuid())
  partId          String
  code            String
  title           String
  description     String?
  isAutoGenerated Boolean           @default(false)
  order           Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  clauses         AgreementClause[]
  part            AgreementPart     @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model AgreementTemplate {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  schemeId            String
  version             Int                  @default(1)
  status              String               @default("DRAFT")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  parts               AgreementPart[]
  scheme              Scheme               @relation(fields: [schemeId], references: [id])
  formCs              ApplicationFormC[]
  generatedAgreements GeneratedAgreement[]
}

model AllocationHeadMaster {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model ApplicationAward {
  id           String           @id @default(uuid())
  formBId      String
  name         String
  organization String
  year         String
  prize        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  formB        ApplicationFormB @relation(fields: [formBId], references: [id], onDelete: Cascade)
}

model ApplicationFormB {
  id                       String                   @id @default(uuid())
  applicationId            String                   @unique
  operationalAddress       String?
  authorityName            String?
  authorityDesignation     String?
  authorityEmail           String?
  authorityMobile          String?
  authorityPan             String?
  bankName                 String?
  branchName               String?
  accountNo                String?
  ifscCode                 String?
  accountType              String?
  accountHolderName        String?
  previousIncubation       String?                  @default("no")
  previousIncubatorName    String?
  previousIncubationPeriod String?
  govtSchemes              String?                  @default("no")
  govtSchemeDetails        String?
  coi                      String?
  moa                      String?
  aoa                      String?
  gstCert                  String?
  panCard                  String?
  cancelledCheque          String?
  declaration1             Boolean                  @default(false)
  declaration2             Boolean                  @default(false)
  declaration3             Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  awards                   ApplicationAward[]
  application              StartupApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  founders                 ApplicationFounder[]
  fundingRecords           ApplicationFunding[]
  ipRecords                ApplicationIP[]
  shareholders             ApplicationShareholder[]
}

model ApplicationFunding {
  id          String           @id @default(uuid())
  formBId     String
  roundType   String
  amountInr   Float
  fundingDate DateTime?
  investors   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  formB       ApplicationFormB @relation(fields: [formBId], references: [id], onDelete: Cascade)
}

model ApplicationFormC {
  id                   String             @id @default(uuid())
  applicationId        String             @unique
  agreementDate        DateTime?
  agreementDuration    Int?
  agreementType        String?
  referenceNumber      String?            @unique
  remarks              String?
  incubationType       String?
  incubationStartDate  DateTime?
  incubationLocation   String?
  incubationFacilities String[]
  grantType            String?
  sanctionedAmount     Float?
  disbursementMode     String?
  ucRequired           Boolean            @default(true)
  reportFrequency      String?
  reviewCommittee      String?
  auditRequired        Boolean            @default(true)
  kpiParameters        String[]
  ipOwnership          String?
  ndaObligations       String?
  publicationPolicy    String?
  governingLaw         String?            @default("Laws of India")
  jurisdiction         String?            @default("Courts of Ahmedabad, Gujarat")
  isUndertakingSigned  Boolean            @default(false)
  undertakingSignedAt  DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  templateId           String?
  application          StartupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  template             AgreementTemplate? @relation(fields: [templateId], references: [id])
}

model ApplicationFounder {
  id                   String           @id @default(uuid())
  formBId              String
  name                 String?
  designation          String?
  email                String?
  mobile               String?
  pan                  String?
  aadhaar              String?
  address              String?
  photo                String?
  addressProof         String?
  govtId               String?
  panCard              String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  degreeCertificate    String?
  degreeName           String?
  lastEducation        String?
  marksheet            String?
  passingYear          String?
  universityName       String?
  whatsapp             String?
  linkedIn             String?
  priorVentures        String?
  gender               String?
  differentlyAbled     Boolean?
  firstGenEntrepreneur Boolean?
  formB                ApplicationFormB @relation(fields: [formBId], references: [id], onDelete: Cascade)
}

model ApplicationIP {
  id             String           @id @default(uuid())
  formBId        String
  type           String
  title          String
  registrationNo String
  status         String
  filingDate     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  formB          ApplicationFormB @relation(fields: [formBId], references: [id], onDelete: Cascade)
}

model ApplicationReview {
  id               String             @id @default(uuid())
  applicationId    String
  reviewerId       String
  level            ApplicationLevel
  screeningScore   Float              @default(0)
  businessScore    Float              @default(0)
  marketScore      Float              @default(0)
  innovationScore  Float              @default(0)
  feasibilityScore Float              @default(0)
  totalScore       Float              @default(0)
  uspNote          String?
  comments         String
  recommendation   String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  application      StartupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer         User               @relation(fields: [reviewerId], references: [id])

  @@index([applicationId])
  @@index([reviewerId])
}

model ApplicationShareholder {
  id          String           @id @default(uuid())
  formBId     String
  name        String
  type        String
  shares      String?
  percentage  Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  certificate String?
  formB       ApplicationFormB @relation(fields: [formBId], references: [id], onDelete: Cascade)
}

model City {
  id         String    @id @default(uuid())
  name       String
  districtId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  district   District? @relation(fields: [districtId], references: [id])

  @@unique([name, districtId])
}

model Cohort {
  id                 String               @id @default(uuid())
  name               String
  startDate          DateTime
  domain             String?
  budget             Float?
  schemeId           String
  managerId          String?
  status             String               @default("Active")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  endDate            DateTime?
  milestoneTemplates Json?
  waitlistSettings   Json?
  manager            User?                @relation(fields: [managerId], references: [id])
  scheme             Scheme               @relation(fields: [schemeId], references: [id])
  meetings           CohortMeeting[]
  members            CohortMember[]
  mentors            CohortMentor[]
  modules            CohortModule[]
  tasks              CohortTask[]
  applications       StartupApplication[]
}

model CohortAttendance {
  id        String        @id @default(uuid())
  meetingId String
  startupId String
  isPresent Boolean       @default(false)
  markedAt  DateTime?     @default(now())
  remarks   String?
  meeting   CohortMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([meetingId, startupId])
  @@index([meetingId])
  @@index([startupId])
}

model CohortMeeting {
  id           String             @id @default(uuid())
  cohortId     String
  moduleId     String?
  title        String
  type         String
  startTime    DateTime
  endTime      DateTime?
  instructorId String?
  meetingLink  String?
  status       String             @default("Upcoming")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  attendance   CohortAttendance[]
  cohort       Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  instructor   User?              @relation(fields: [instructorId], references: [id])
  module       CohortModule?      @relation(fields: [moduleId], references: [id])

  @@index([cohortId])
  @@index([instructorId])
  @@index([moduleId])
}

model CohortMember {
  id        String   @id @default(uuid())
  cohortId  String
  userId    String
  status    String   @default("Active")
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

model CohortMentor {
  id        String   @id @default(uuid())
  cohortId  String
  userId    String
  role      String   @default("Advisor")
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

model CohortModule {
  id            String           @id @default(uuid())
  cohortId      String
  title         String
  description   String?
  sequenceOrder Int              @default(0)
  totalSessions Int              @default(0)
  status        String           @default("Draft")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  meetings      CohortMeeting[]
  cohort        Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  resources     ModuleResource[]

  @@index([cohortId])
}

model CohortSubmission {
  id              String     @id @default(uuid())
  taskId          String
  startupId       String
  fileUrl         String?
  linkUrl         String?
  submittedAt     DateTime   @default(now())
  status          String     @default("Submitted")
  reviewerRemarks String?
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  task            CohortTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([status])
  @@index([taskId])
}

model CohortTask {
  id             String             @id @default(uuid())
  cohortId       String
  title          String
  description    String?
  dueDate        DateTime
  priority       String             @default("Medium")
  submissionType String             @default("File")
  status         String             @default("Active")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  submissions    CohortSubmission[]
  cohort         Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  states    State[]
}

model Department {
  id                    String                  @id @default(uuid())
  name                  String
  institutionId         String
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  institution           Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userDepartmentMapping UserDepartmentMapping[]

  @@unique([name, institutionId])
}

model Designation {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  userDepartmentMapping UserDepartmentMapping[]
}

model District {
  id              String   @id @default(uuid())
  name            String
  stateId         String
  pincodePrefixes String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cities          City[]
  state           State    @relation(fields: [stateId], references: [id])

  @@unique([name, stateId])
}

model GeneratedAgreement {
  id                  String             @id @default(uuid())
  agreementNumber     String             @unique
  title               String
  description         String?
  executionDate       DateTime?
  validityStart       DateTime?
  validityEnd         DateTime?
  status              AgreementStatus    @default(DRAFT)
  version             Int                @default(1)
  undertakingNumber   String?            @unique
  undertakingDate     DateTime?
  incubationType      String?
  incubationStartDate DateTime?
  incubationDuration  Int?
  sanctionedAmount    Float?             @default(0)
  disbursementMode    String?
  variables           Json
  workflowStatus      Json?
  applicationId       String
  templateId          String
  schemeId            String?
  centerProfileId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  application         StartupApplication @relation(fields: [applicationId], references: [id])
  centerProfile       IncubationCenter?  @relation(fields: [centerProfileId], references: [id])
  scheme              Scheme?            @relation(fields: [schemeId], references: [id])
  template            AgreementTemplate  @relation(fields: [templateId], references: [id])

  @@index([agreementNumber])
  @@index([applicationId])
  @@index([status])
}

model Grant {
  id                 String                   @id @default(uuid())
  name               String
  code               String                   @unique
  type               String
  source             String
  agency             String
  schemeId           String
  sectors            String[]
  totalAmount        Float
  maxPerStartup      Float
  cycle              String
  fy                 String
  status             String                   @default("Draft")
  trancheAllowed     Boolean                  @default(false)
  noOfTranches       Int                      @default(0)
  ucMandatory        Boolean                  @default(true)
  auditRequired      Boolean                  @default(false)
  matchingFund       Boolean                  @default(false)
  recoveryClause     Boolean                  @default(true)
  utilisationPeriod  Int?                     @default(30)
  utilisationPurpose String?
  bankDetails        String?
  approvalAuthority  String?
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  disbursementMode   String?
  approvalDate       DateTime?
  approvalRef        String?
  approvalRemarks    String?
  closureDate        DateTime?
  deletedAt          DateTime?
  milestoneTemplates Json?
  scheme              Scheme                   @relation(fields: [schemeId], references: [id])
  allocations         GrantAllocation[]
  receipts            GrantReceipt[]
  tranches            GrantTranche[]
  startupAllocations  StartupGrantAllocation[]
  ucBudgetHeads       UCBudgetHead[]
  milestoneTemplates2 MilestoneTemplate[]

  @@index([deletedAt])
}

model GrantAllocation {
  id        String    @id @default(uuid())
  grantId   String
  head      String
  amount    Float
  utilized  Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  remarks   String?
  code      String?   @unique
  deletedAt DateTime?
  grant     Grant     @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
}

model GrantReceipt {
  id          String    @id @default(uuid())
  grantId     String
  date        DateTime
  amount      Float
  installment String
  utr         String
  from        String
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  code        String?   @unique
  deletedAt   DateTime?
  grant       Grant     @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
}

model GrantTranche {
  id         String   @id @default(uuid())
  grantId    String
  milestone  String
  percentage Float
  amount     Float
  status     String   @default("Pending")
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  grant      Grant    @relation(fields: [grantId], references: [id], onDelete: Cascade)
}

model IncubationCenter {
  id                  String               @id @default(uuid())
  name                String
  universityName      String
  address             String
  authorizedSignatory String
  designation         String
  email               String
  mobile              String
  officialSealUrl     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  gstin               String?
  logoUrl             String?
  pan                 String?
  parentLogoUrl       String?
  parentName          String?
  website             String?
  GeneratedAgreement  GeneratedAgreement[]
}

model Institution {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  departments           Department[]
  userDepartmentMapping UserDepartmentMapping[]
}

model LibraryClause {
  id         String   @id @default(uuid())
  title      String
  content    String
  category   String?
  tags       String[]
  isOptional Boolean  @default(false)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDefault  Boolean  @default(false)
}

model Milestone {
  id             String                   @id @default(uuid())
  startupId      String
  title          String
  description    String?
  categoryName   String
  priority       String                   @default("Medium")
  plannedStart   DateTime
  plannedEnd     DateTime
  actualStart    DateTime?
  completionDate DateTime?
  status         MilestoneStatus          @default(NOT_STARTED)
  allocatedFund  Float                    @default(0)
  utilizedFund   Float                    @default(0)
  proofUrl       String?
  approvalStatus AssessmentApprovalStatus @default(DRAFT)
  sprAutoFetched Boolean                  @default(false)
  sprTypeMapping String[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  trancheId      String?
  templateId     String?
  sprFrequency   SprFrequency             @default(MONTHLY)
  sprCount       Int                      @default(1)
  category       MilestoneCategory        @relation(fields: [categoryName], references: [name])
  startup        User                     @relation(fields: [startupId], references: [id])
  tranche        StartupGrantTranche?     @relation(fields: [trancheId], references: [id])
  template       MilestoneTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sprs           StartupProgressReport[]

  @@index([approvalStatus])
  @@index([categoryName])
  @@index([startupId])
  @@index([status])
  @@index([templateId])
  @@index([trancheId])
}

model MilestoneTemplate {
  id               String       @id @default(uuid())
  grantId          String
  title            String
  description      String?
  categoryName     String
  priority         String       @default("Medium")
  durationDays     Int
  trancheNumber    Int
  sprFrequency     SprFrequency @default(MONTHLY)
  sprCount         Int          @default(1)
  sprTypes         String[]
  allocatedFundPct Float        @default(0)
  order            Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  grant            Grant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  milestones       Milestone[]

  @@index([grantId])
  @@index([trancheNumber])
}

model MilestoneCategory {
  id            String      @id @default(uuid())
  name          String      @unique
  color         String      @default("bg-blue-500")
  subcategories String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  milestones    Milestone[]
}

model ModuleResource {
  id        String       @id @default(uuid())
  moduleId  String
  title     String
  type      String
  url       String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  module    CohortModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model OrgRole {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]
}

model PermissionModule {
  id              String           @id @default(uuid())
  key             String           @unique
  label           String
  group           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  id        String           @id @default(uuid())
  roleId    String
  moduleId  String
  actions   String[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  module    PermissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role      OrgRole          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
}

model SPRAssessment {
  id                   String                @id @default(uuid())
  sprId                String                @unique
  productValidation    KPIStatus             @default(PENDING)
  innovationIP         KPIStatus             @default(PENDING)
  marketTraction       KPIStatus             @default(PENDING)
  technologyProgress   KPIStatus             @default(PENDING)
  goToMarket           KPIStatus             @default(PENDING)
  financialDiscipline  KPIStatus             @default(PENDING)
  customerSatisfaction KPIStatus             @default(PENDING)
  compliance           KPIStatus             @default(PENDING)
  revenueGrowth        KPIStatus             @default(PENDING)
  fundingRaised        KPIStatus             @default(PENDING)
  milestoneRate        KPIStatus             @default(PENDING)
  teamExpansion        KPIStatus             @default(PENDING)
  socialImpact         KPIStatus             @default(PENDING)
  partnerships         KPIStatus             @default(PENDING)
  healthScore          Float?
  observations         String?
  recommendations      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  progressReport       StartupProgressReport @relation(fields: [sprId], references: [id], onDelete: Cascade)
}

model SPRMasterConfig {
  id              String   @id @default(uuid())
  name            String
  frequency       String
  reminderDays    Int      @default(7)
  mandatoryFields String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Scheme {
  id                  String               @id @default(uuid())
  name                String
  code                String               @unique
  type                String
  providedBy          String?
  organizationName    String?
  categories          String[]
  sectors             String[]
  departments         String[]
  description         String?
  objectives          String?
  eligibility         String?
  targetBeneficiaries String[]
  totalBudget         Float?
  maxGrant            Float
  fundingType         String[]
  selectionCriteria   String?
  evaluationProcess   String?
  installments        Int?
  duration            String?
  validityPeriods     Json?
  applicationPeriods  Json?
  requiredDocuments   Json?
  status              SchemeStatus         @default(DRAFT)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  applicationFormJson Json?
  equityPercentage    Float?
  templates           AgreementTemplate[]
  cohorts             Cohort[]
  generatedAgreements GeneratedAgreement[]
  grants              Grant[]
  applications        StartupApplication[]

  @@index([deletedAt])
}

model Sector {
  id             String          @id @default(uuid())
  name           String          @unique
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  subSectors     SubSector[]
  mentorProfiles MentorProfile[]
}

model StartupApplication {
  id                      String                  @id @default(uuid())
  applicationNo           String?                 @unique
  status                  ApplicationStatus       @default(DRAFT)
  currentLevel            ApplicationLevel        @default(LEVEL_1)
  schemeId                String
  version                 Int                     @default(1)
  fullName                String
  designation             String
  email                   String
  mobile                  String
  whatsapp                String?
  aadhaar                 String
  gender                  String
  dob                     DateTime
  highestQualification    String
