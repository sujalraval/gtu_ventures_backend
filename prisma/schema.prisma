enum EventType {
  DEMO_DAY
  INVESTOR_DAY
  WORKSHOP
  MASTERCLASS
  HACKATHON
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventMode {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  NO_SHOW
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Event {
  id                   String               @id @default(uuid())
  code                 String               @unique
  title                String
  type                 EventType
  status               EventStatus          @default(DRAFT)
  mode                 EventMode            @default(IN_PERSON)
  description          String?              @db.Text
  venue                String?
  virtualLink          String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  maxAttendees         Int?
  isPublic             Boolean              @default(true)
  targetCohorts        String[]             @default([])
  targetSchemes        String[]             @default([])
  coverImage           String?
  tags                 String[]             @default([])
  agenda               Json?
  organiserName        String?
  organiserEmail       String?
  createdBy            String
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  creator              User                 @relation("EventCreator", fields: [createdBy], references: [id])
  registrations        EventRegistration[]
  invites              EventInvite[]
  pitchDecks           PitchDeckSubmission[]
  scheduleSlots        EventScheduleSlot[]  @relation("EventSchedule")
  scorecardCriteria    ScorecardCriteria[]  @relation("EventCriteria")
  judgeAssignments     JudgeAssignment[]    @relation("EventJudges")
  scores               StartupScore[]       @relation("EventScores")
}

model EventRegistration {
  id           String             @id @default(uuid())
  eventId      String
  name         String
  email        String
  phone        String?
  organization String?
  designation  String?
  qrToken      String             @unique               // UUID used in QR code
  status       RegistrationStatus @default(CONFIRMED)
  isInvited    Boolean            @default(false)       // came via invite
  checkedInAt  DateTime?
  checkedInBy  String?                                  // admin user id who scanned
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@index([qrToken])
}

model EventInvite {
