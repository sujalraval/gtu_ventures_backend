  updatedAt DateTime     @updatedAt

  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

enum PitchDeckStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REVISION_REQUESTED
}

model PitchDeckSubmission {
  id            String          @id @default(uuid())
  eventId       String
  startupId     String                              // User.id of STARTUP role
  version       Int             @default(1)
  fileName      String
  filePath      String                              // server file path
  fileSize      Int?                                // bytes
  mimeType      String?
  status        PitchDeckStatus @default(PENDING)
  isActive      Boolean         @default(true)     // only one active per startup per event
  reviewerNotes String?         @db.Text
  reviewedBy    String?                             // admin User.id
  reviewedAt    DateTime?
  submittedAt   DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startup       User            @relation("PitchDeckStartup", fields: [startupId], references: [id])
  reviewer      User?           @relation("PitchDeckReviewer", fields: [reviewedBy], references: [id])
  scheduleSlot  EventScheduleSlot?

  @@index([eventId])
  @@index([startupId])
  @@index([eventId, startupId])
}

model EventScheduleSlot {
  id              String    @id @default(uuid())
  eventId         String
  startupId       String                              // User.id of STARTUP
  pitchDeckId     String?   @unique                    // optional link to accepted deck
  position        Int                                 // 1-based presentation order
  scheduledTime   DateTime?                           // exact time slot
  durationMins    Int       @default(10)              // presentation duration
  bufferMins      Int       @default(5)               // Q&A / buffer after slot
  notes           String?   @db.Text
  emailSentAt     DateTime?                           // when schedule email was sent
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event           Event     @relation("EventSchedule", fields: [eventId], references: [id], onDelete: Cascade)
  startup         User      @relation("SlotStartup", fields: [startupId], references: [id])
  pitchDeck       PitchDeckSubmission? @relation(fields: [pitchDeckId], references: [id], onDelete: SetNull)

  @@unique([eventId, position])
  @@unique([eventId, startupId])
  @@index([eventId])
}

