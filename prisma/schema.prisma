// ── Module 8: Communication & Notification Engine ─────────────────────────────

enum AnnouncementAudience {
  ALL
  ALL_STARTUPS
  ALL_MENTORS
  ALL_STAFF
  SPECIFIC_COHORT
  SPECIFIC_SCHEME
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

// Bulk announcements sent by admins
model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String               @db.Text
  audience    AnnouncementAudience @default(ALL_STARTUPS)
  cohortId    String?              // if audience = SPECIFIC_COHORT
  schemeId    String?              // if audience = SPECIFIC_SCHEME
  channel     NotificationChannel  @default(EMAIL)
  sentBy      String               // User.id of admin who sent
  recipientCount Int               @default(0)
  sentAt      DateTime             @default(now())
  createdAt   DateTime             @default(now())

  sender      User                 @relation("AnnouncementSender", fields: [sentBy], references: [id])
  logs        NotificationLog[]
}

// Reusable email/in-app templates with merge fields
model NotificationTemplate {
  id          String              @id @default(uuid())
  name        String              @unique
  subject     String?             // for email
  body        String              @db.Text
  channel     NotificationChannel @default(EMAIL)
  mergeFields String[]            @default([])  // list of {{field_name}} tokens used
  isActive    Boolean             @default(true)
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  creator     User                @relation("TemplateCreator", fields: [createdBy], references: [id])
}

// Per-recipient delivery log for announcements and ad-hoc emails
model NotificationLog {
  id             String              @id @default(uuid())
  announcementId String?
  recipientId    String?             // User.id (null for external)
  recipientEmail String
  subject        String?
  channel        NotificationChannel @default(EMAIL)
  status         NotificationStatus  @default(PENDING)
  errorMessage   String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  announcement   Announcement?       @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  recipient      User?               @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([announcementId])
  @@index([recipientId])
  @@index([status])
}

