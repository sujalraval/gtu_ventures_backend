  vcFirm         VcFirm               @relation(fields: [vcFirmId], references: [id], onDelete: Cascade)
  startup        User                 @relation("VcInterestStartup", fields: [startupId], references: [id])
  meetings       VcMeeting[]
  outcome        VcInvestmentOutcome?

  @@unique([vcFirmId, startupId])
  @@index([vcFirmId])
  @@index([startupId])
}

model VcMeeting {
  id            String      @id @default(uuid())
  vcFirmId      String
  startupId     String
  interestId    String?
  title         String
  scheduledAt   DateTime
  durationMins  Int         @default(60)
  mode          String      @default("ONLINE")
  meetingLink   String?
  calendarLink  String?
  location      String?
  notes         String?
  status        String      @default("SCHEDULED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  vcFirm        VcFirm      @relation(fields: [vcFirmId], references: [id], onDelete: Cascade)
  startup       User        @relation("VcMeetingStartup", fields: [startupId], references: [id])
  interest      VcInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([vcFirmId])
  @@index([startupId])
}

model VcInvestmentOutcome {
  id             String     @id @default(uuid())
  interestId     String     @unique
  amountInr      Float
  instrumentType String
  investorName   String
  closedAt       DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  interest       VcInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
}

// ── Feature 5: Live Scorecard ─────────────────────────────────────────────────

// Scoring criteria template per event (admin defines before judging starts)
model ScorecardCriteria {
  id          String   @id @default(uuid())
  eventId     String
  name        String                        // e.g. "Innovation", "Market Potential"
  description String?  @db.Text
  maxScore    Int      @default(10)
  weight      Float    @default(1.0)        // multiplier for weighted total
  position    Int      @default(1)          // display order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation("EventCriteria", fields: [eventId], references: [id], onDelete: Cascade)
  scores      StartupScore[]

  @@unique([eventId, name])
  @@index([eventId])
}

// Which judges are assigned to score which startups for an event
model JudgeAssignment {
  id        String   @id @default(uuid())
  eventId   String
  judgeId   String                          // User.id (role MENTOR or any assigned user)
  startupId String?                         // null = judge scores ALL startups
  createdAt DateTime @default(now())

  event     Event    @relation("EventJudges", fields: [eventId], references: [id], onDelete: Cascade)
  judge     User     @relation("JudgeAssignments", fields: [judgeId], references: [id])

  @@unique([eventId, judgeId, startupId])
  @@index([eventId])
  @@index([judgeId])
}

// Individual criterion score submitted by a judge for a startup
model StartupScore {
  id          String   @id @default(uuid())
  eventId     String
  criteriaId  String
  judgeId     String
  startupId   String
  score       Float                         // 0 – criteria.maxScore
  comment     String?  @db.Text
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event              @relation("EventScores", fields: [eventId], references: [id], onDelete: Cascade)
  criteria    ScorecardCriteria  @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  judge       User               @relation("JudgeScores", fields: [judgeId], references: [id])
  startup     User               @relation("StartupScoresReceived", fields: [startupId], references: [id])

  @@unique([eventId, criteriaId, judgeId, startupId])
  @@index([eventId])
  @@index([judgeId])
  @@index([startupId])
}

